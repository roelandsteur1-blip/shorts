# Installed by setup.sh (placeholders filled in). The dashboard and the jobs it runs, always on.
[Unit]
Description=Shorts dashboard
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
WorkingDirectory=@REPO@
Environment=PATH=@PATH@
Environment=PYTHONUNBUFFERED=1
ExecStart=@REPO@/.venv/bin/python -m shorts dashboard
Restart=always
RestartSec=10
# Only the dashboard itself is stopped: running jobs (a make) keep going through a restart or an
# update and the new dashboard picks them up again. Stop a job with its Stop button.
KillMode=process
Nice=5

[Install]
WantedBy=multi-user.target
